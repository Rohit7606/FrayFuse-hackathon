    "TriageQueue": {
      "type": "string",
      "enum": [
        "fund_now",
        "derisk",
        "monitor",
        "clear",
        "origin"
      ],
      "description": "Which queue a supplier belongs in - a DECISION, not a score. fund_now: fragile AND irreplaceable. derisk: fragile but relatively replaceable - watch and second-source rather than fund. monitor: stress has reached it but it is not yet fragile, or it is a solvent chokepoint. clear: nothing meaningful reached it. origin: the stress starts here, so it is a diagnosis and not a rescue target, for the same reason ranking excludes origins. Not derivable from risk_band: fragility 0.35 x criticality 0.20 and fragility 0.10 x criticality 0.70 are the same final_score and the opposite response."
    },
    "Delta": {
