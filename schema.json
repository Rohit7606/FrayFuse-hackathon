        "transaction_date"
      ],
      "description": "Schedule III ages from the due date; some filers age from the transaction date. Buckets from different bases are NOT comparable under the same column names. Required - never null."
    },
    "EdgeConfidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "probable",
        "concentration_only"
      ],
      "description": "How well evidenced this relationship is. 'probable' is inference, not disclosure - the UI must never present it as fact. Required - never null."
    },
    "EdgeProvenance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "related_party_note",
        "related_party",
        "mdna",
        "segment_note",
        "rating_agency",
        "awards_page",
        "press",
        "auditor_note",
        "contingent_liability_note",
        "synthetic",
        null
      ],
      "description": "Where the edge came from. related_party_note means a group or promoter-affiliated entity disclosed under Ind AS 24 - a real dependency, but not an arm's-length supply relationship. 'press' is the weakest: reported, not filed. null means not recorded."
    },
    "ObservationCompleteness": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "observed",
        "partially_observed",
        "not_observed",
        null
      ],
      "description": "Whether this node's relationships were actually searched for. Without it, 'not critical' and 'not yet observed' are indistinguishable in the score — and the second is far more common. null means not recorded."
    },
    "AnchorDisruption": {
      "type": "object",
